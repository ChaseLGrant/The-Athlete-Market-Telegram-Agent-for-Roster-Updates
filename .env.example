# ============================================================
# The Athlete Market — Roster Intelligence
# Copy this file to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Safety switches -----------------------------------------
# TEST_MODE=true  -> uses saved test data, never sends to Telegram (logs posts instead)
# DRY_RUN=true    -> real data collection + analysis, but never sends to Telegram
# Go live only when both are false.
TEST_MODE=true
DRY_RUN=false

# --- Database ------------------------------------------------
# Local quick start (no setup needed):
DATABASE_URL=sqlite:///./roster_intel.db
# Supabase (Project Settings -> Database -> Connection string -> URI, "Session pooler"):
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# --- Time ----------------------------------------------------
APP_TIMEZONE=America/Los_Angeles
# Daily post times (24h, in APP_TIMEZONE)
PUBLISH_TIMES=baseball=09:00,football=09:15,softball=09:30,mens_basketball=09:45,womens_basketball=10:00,mens_soccer=10:15,womens_soccer=10:30
RESEARCH_CRON_HOUR=3
ENABLE_SCHEDULER=false

# --- Admin dashboard login -----------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Telegram (from @BotFather) ------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BASEBALL_CHANNEL_ID=
TELEGRAM_FOOTBALL_CHANNEL_ID=
TELEGRAM_SOFTBALL_CHANNEL_ID=
TELEGRAM_MBB_CHANNEL_ID=
TELEGRAM_WBB_CHANNEL_ID=
TELEGRAM_MSOC_CHANNEL_ID=
TELEGRAM_WSOC_CHANNEL_ID=
# Private review chat (optional): new items arrive with Approve / Reject buttons.
# Find your id: open your bot in Telegram, press Start, then run  python -m app.cli telegram-whoami
TELEGRAM_ADMIN_CHAT_ID=
# Who may press the buttons (Telegram user ids, comma separated). Blank = the admin chat id.
TELEGRAM_ADMIN_USER_IDS=
# Only for instant button presses via the hosted dashboard (python -m app.cli telegram-webhook --set)
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
# Public invite links used in X teasers (sport=link, comma separated)
TELEGRAM_JOIN_LINKS=baseball=https://t.me/your_baseball_channel

# --- Claude (optional; off by default) -----------------------
# Only classifies odd roster position strings; all math stays deterministic.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Crawling (be polite) ------------------------------------
CRAWLER_USER_AGENT=TAMRosterIntelBot/0.1 (+https://theathletemarket.com; roster research)
CRAWLER_MIN_DELAY_SECONDS=10
CACHE_TTL_HOURS=12
REVALIDATE_AFTER_HOURS=48
OPPORTUNITY_TTL_DAYS=21
